{
  "name": "aegis-protocol-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node --eval \"require('node:fs').copyFileSync('src/schema.sql','dist/schema.sql')\"",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.70.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "viem": "^2.33.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
