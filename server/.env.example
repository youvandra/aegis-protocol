# ---------------------------------------------------------------------------
# Server. These never reach the browser.
# ---------------------------------------------------------------------------

PORT=8080

# SQLite file. Must live on a persistent volume — losing it loses every
# legacy plan, group and relay.
DATABASE_PATH=./data/aegis.db

# Directory holding the built frontend (`npm run build` at the repo root).
STATIC_DIR=../dist

# Hedera operator. Pays for every consensus topic and message.
HEDERA_ACCOUNT_ID="0.0.YOUR_ACCOUNT"
HEDERA_PRIVATE_KEY="YOUR_ECDSA_PRIVATE_KEY"
HEDERA_NETWORK="testnet"
# HEDERA_MIRROR_NODE_URL="https://testnet.mirrornode.hedera.com"

# Session lifetime in seconds (default 3600) and sign-in challenge TTL.
# SESSION_TTL_SECONDS=3600
# NONCE_TTL_SECONDS=300
