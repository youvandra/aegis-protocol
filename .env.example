# ---------------------------------------------------------------------------
# Frontend (Vite). Every VITE_ value is inlined into the JavaScript served to
# browsers, so nothing secret may go here.
# ---------------------------------------------------------------------------

# WalletConnect Cloud project ID
VITE_WAGMI_PROJECT_ID="YOUR_WALLETCONNECT_PROJECT_ID"

# Hedera account that receives scheduled stream deposits (public information).
VITE_HEDERA_ACCOUNT_ID="0.0.YOUR_ACCOUNT"

# Only set this when the API is hosted somewhere other than the app's own
# origin. In production the server serves both, so leave it unset.
# VITE_API_URL="https://aegis.example.com"
