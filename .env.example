# Supabase project (Settings -> API)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# WalletConnect Cloud project ID
VITE_WAGMI_PROJECT_ID="YOUR_WALLETCONNECT_PROJECT_ID"

# Hedera account that receives scheduled stream deposits.
# Public information only — the operator PRIVATE KEY must never be a VITE_ var,
# because Vite inlines every VITE_ value into the JavaScript it ships to
# browsers. The key belongs in the edge function secrets (see README).
VITE_HEDERA_ACCOUNT_ID="0.0.YOUR_ACCOUNT"

# Optional: point at a different mirror node (defaults to public testnet).
# VITE_HEDERA_MIRROR_NODE_URL="https://testnet.mirrornode.hedera.com"
